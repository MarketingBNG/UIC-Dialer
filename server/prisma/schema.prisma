// UIC Dialer database schema.
// Postgres features Prisma can't express (pg_trgm extension, the generated
// tsvector column and its GIN index) live in hand-edited migration SQL.
// When creating new migrations, check the generated SQL does not drop them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum CallDirection {
  INCOMING
  OUTGOING
  MISSED
  UNKNOWN
}

enum CallSource {
  LIVE
  BACKLOG
  IMPORT
}

enum CallStatus {
  PENDING_UPLOAD
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  FAILED
  // From the phone's call log with no recording (missed, rejected, unanswered, or not recorded).
  // Becomes PENDING_UPLOAD when a recording for the same call arrives. Hidden from /api/calls unless ?v=2.
  NO_RECORDING
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  // Deferred by the Fireflies budget / batch gate; claimable again after run_after.
  WAITING_BUDGET
}

enum AuditAction {
  PLAY
  DOWNLOAD
  SEARCH
  DELETE
  USER_CHANGE
  DEVICE_REVOKE
  // Milestone 3: privacy settings, client list edits, retention deletes.
  SETTINGS_CHANGE
  CLIENT_LIST_CHANGE
  RETENTION_DELETE
  // Milestone 5: CSV export of the call list.
  EXPORT
  // Zoho CRM: admin resync / backfill.
  CRM_SYNC
  // Stage 3 (migration 20261118101000). /api/audit hides these from old apps unless ?v=2.
  CALL_LIST_CHANGE
  CONTACT_IMPORT
  DNC_CHANGE
  LEAD_SOURCE_CHANGE
  OUTCOME_CHANGE
  TEMPLATE_CHANGE
  TARGET_CHANGE
}

// Emails that may never sign in (admin "Blocked" list), whether or not they have an account yet.
model BlockedEmail {
  email       String   @id
  reason      String?
  blockedById String?  @map("blocked_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("blocked_emails")
}

/** Problems staff devices report (failed laptop dials, etc.). Shown on the Health page; kept 30 days. */
model ClientError {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  deviceId  String?  @map("device_id") @db.Uuid
  source    String
  kind      String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("client_errors")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  googleSub       String?   @unique @map("google_sub")
  name            String?
  pictureUrl      String?   @map("picture_url")
  role            Role      @default(AGENT)
  team            String?
  active          Boolean   @default(true)
  excludedNumbers String[]  @default([]) @map("excluded_numbers")
  lastLoginAt     DateTime? @map("last_login_at")
  // Daily targets (stage 3); null = no target.
  targetCallsPerDay   Int?  @map("target_calls_per_day")
  targetTalkMinPerDay Int?  @map("target_talk_min_per_day")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  devices  Device[]
  webSessions WebSession[]
  calls    Call[]
  auditLog AuditLog[]

  ownedContacts Contact[]  @relation("ContactOwner")
  activities    Activity[]
  followUpTasks FollowUpTask[]
  dialIntents   DialIntent[]

  callListsCreated CallList[]         @relation("CallListCreator")
  callListAssigned CallListAssignee[]
  listItemsClaimed CallListItem[]     @relation("ListItemClaimedBy")
  listItemsDone    CallListItem[]     @relation("ListItemDoneBy")
  dncCreated       DncNumber[]
  leadsAssigned    LeadEvent[]

  @@map("users")
}

model Device {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  installId      String    @map("install_id")
  model          String?
  androidVersion String?   @map("android_version")
  appVersion     String?   @map("app_version")
  lastSeenAt     DateTime? @map("last_seen_at")
  lastSyncAt     DateTime? @map("last_sync_at")
  pendingCount   Int       @default(0) @map("pending_count")
  permissionsOk  Boolean   @default(false) @map("permissions_ok")
  freeBytes      BigInt?   @map("free_bytes")
  /// UsageStatsManager bucket: 5 ACTIVE, 10 WORKING_SET, 20 FREQUENT, 30 RARE, 40 RESTRICTED, 45 RESTRICTED (API 31+ some OEMs), 50 NEVER.
  standbyBucket  Int?      @map("standby_bucket")
  lastStopReason Int?      @map("last_stop_reason")
  /// Calls over 30 s in the phone call log over the last 7 days, and recordings found for the same window.
  calls7d        Int?      @map("calls_7d")
  recordings7d   Int?      @map("recordings_7d")
  autostartIntent String?  @map("autostart_intent")
  defaultDialer  String?   @map("default_dialer")
  /// Android refused the older-recordings foreground notification (exception class): background runs are cut to ~10 min.
  backlogFgsError String?  @map("backlog_fgs_error")
  revokedAt      DateTime? @map("revoked_at")
  /// First heartbeat that listed SIMs; never changes. SIMs reported later than this are "new".
  simsReportedAt DateTime? @map("sims_reported_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  calls         Call[]
  sims          DeviceSim[]

  @@unique([userId, installId])
  @@map("devices")
}

/// A SIM seen on a device (from heartbeats and calls). number is E.164, read from the SIM or typed by the user/admin.
model DeviceSim {
  id          String    @id @default(uuid(7)) @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  simKey      String    @map("sim_key")
  slot        Int?
  carrier     String?
  number      String?
  /// SIM | USER | ADMIN
  numberSetBy String?   @map("number_set_by")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  /// First heartbeat that listed this SIM; never changes. Null for SIMs known only from uploaded calls.
  reportedAt  DateTime? @map("reported_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, simKey])
  @@map("device_sims")
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  deviceId   String    @map("device_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("refresh_tokens")
}

model Call {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  deviceId       String?       @map("device_id") @db.Uuid
  phoneE164      String?       @map("phone_e164")
  phoneRaw       String?       @map("phone_raw")
  contactName    String?       @map("contact_name")
  direction      CallDirection @default(UNKNOWN)
  source         CallSource    @default(LIVE)
  startedAt      DateTime      @map("started_at")
  durationS      Int?          @map("duration_s")
  originalName   String?       @map("original_name")
  originalSha256 String        @map("original_sha256")
  uploadSha256   String?       @map("upload_sha256")
  mimeType       String?       @map("mime_type")
  filePath       String?       @map("file_path")
  fileSize       BigInt?       @map("file_size")
  status         CallStatus    @default(PENDING_UPLOAD)
  uploadedAt     DateTime?     @map("uploaded_at")
  // Set when the worker re-encoded the stored audio to small AAC (Milestone 2b); bytes freed on disk.
  compressedAt   DateTime?     @map("compressed_at")
  bytesSaved     BigInt?       @map("bytes_saved")
  // Set when the retention job deleted the audio file (transcript kept).
  audioDeletedAt DateTime?     @map("audio_deleted_at")
  // Zoho CRM sync (src/crm/sync.ts). crmStatus: SYNCED | NO_MATCH | ERROR | null (not tried yet).
  crmStatus        String?   @map("crm_status")
  crmCallId        String?   @map("crm_call_id")
  crmNoteId        String?   @map("crm_note_id")
  crmRecordModule  String?   @map("crm_record_module")
  crmRecordId      String?   @map("crm_record_id")
  crmSyncedAt      DateTime? @map("crm_synced_at")
  crmSyncError     String?   @map("crm_sync_error")
  crmAttempts      Int       @default(0) @map("crm_attempts")
  // Set by an admin resync / backfill: sync even if outside the loop's recent window.
  crmQueuedAt      DateTime? @map("crm_queued_at")
  crmNextAttemptAt DateTime? @map("crm_next_attempt_at")
  // Lease held while one server syncs the call (see CrmSync.claim).
  crmLockedUntil   DateTime? @map("crm_locked_until")
  // How an OUTGOING call was dialled (src/activity/via.ts); null for incoming/missed and old rows.
  via              DialVia?  @map("via")
  // Which SIM on the device made/took the call: the call log's PHONE_ACCOUNT_ID. The number itself lives on
  // DeviceSim (device_id, sim_key) so a corrected number applies to past calls too.
  simKey           String?   @map("sim_key")
  simSlot          Int?      @map("sim_slot")
  simCarrier       String?   @map("sim_carrier")
  // Call-log entry this row came from (src/calls/callLog.ts callLogKey); dedupes re-sent entries and lets a
  // later recording attach to the same row. logType: the call log's own type (INCOMING, OUTGOING, MISSED,
  // REJECTED, BLOCKED, VOICEMAIL, ...); null for rows made only from a recording.
  callLogKey       String?   @map("call_log_key")
  logType          String?   @map("log_type")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  transcript Transcript?
  jobs       Job[]

  firefliesReservations FirefliesReservation[]
  activities            Activity[]
  score                 CallScore?

  @@unique([userId, originalSha256])
  @@unique([userId, callLogKey])
  @@index([userId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@index([crmStatus])
  @@index([phoneE164(ops: raw("gin_trgm_ops"))], type: Gin, map: "calls_phone_e164_trgm_idx")
  @@map("calls")
}

model Transcript {
  callId    String                   @id @map("call_id") @db.Uuid
  text      String
  language  String?
  provider  String
  segments  Json? // after translation each segment also has "en"
  // NO_SPEECH / VOICEMAIL (set by the ElevenLabs worker): kept, but not translated or summarized.
  tag       String?
  // English version made by the worker's translate job; null until translated.
  textEn           String? @map("text_en")
  translationModel String? @map("translation_model")
  // Claude tokens + USD for the current English version (see src/translation/cost.ts).
  translationInputTokens  Int?    @map("translation_input_tokens")
  translationOutputTokens Int?    @map("translation_output_tokens")
  translationCostUsd      Float?  @map("translation_cost_usd")
  // AI summary made by the worker's summarize job (Claude, reads the English text); null until summarized.
  summary             String?
  actionItems         Json?     @map("action_items") // string[]
  sentiment           String? // positive | neutral | negative | mixed
  tags                Json? // string[]
  speakerRoles        Json?     @map("speaker_roles") // [{ speaker, role: Agent | Customer | Unknown }]
  summaryModel        String?   @map("summary_model")
  summaryInputTokens  Int?      @map("summary_input_tokens")
  summaryOutputTokens Int?      @map("summary_output_tokens")
  summaryCostUsd      Float?    @map("summary_cost_usd")
  summarizedAt        DateTime? @map("summarized_at")
  // Generated column: to_tsvector('simple', text || ' ' || coalesce(text_en, '')). Created in migration SQL.
  tsv       Unsupported("tsvector")?
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("transcripts")
}

model Job {
  id        String    @id @default(uuid(7)) @db.Uuid
  callId    String    @map("call_id") @db.Uuid
  kind      String    @default("transcribe")
  priority  Int       @default(0)
  status    JobStatus @default(QUEUED)
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  /// Claude Message Batch id this job was sent in (translate/summarize/score). A worker that claims the job after a
  /// restart waits for that batch instead of sending (and paying for) a new one. Cleared when the job fails.
  externalRef String? @map("external_ref")
  runAfter  DateTime  @default(now()) @map("run_after")
  lockedAt  DateTime? @map("locked_at")
  lockedBy  String?   @map("locked_by")
  // Set when claimed / when DONE or FAILED; used for throughput metrics.
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  // Last failed attempt (retried or final); feeds the failure-rate alert.
  failedAttemptAt DateTime? @map("failed_attempt_at")
  // Claude spend of a translate job (paid even if its result was discarded); feeds the monthly cap.
  costUsd   Float?    @map("cost_usd")
  costAt    DateTime? @map("cost_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([status, priority(sort: Desc), createdAt])
  @@index([finishedAt])
  @@index([failedAttemptAt])
  @@index([costAt])
  @@map("jobs")
}

model AuditLog {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  callId    String?     @map("call_id") @db.Uuid
  detail    Json?
  ip        String?
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_log")
}

// Single-row table (id = 1) holding settings admins can change without a deploy.
model Setting {
  id           Int      @id @default(1)
  deviceConfig Json     @map("device_config")
  latestApp    Json?    @map("latest_app")
  // Fireflies budget settings + hard-stop state (see src/fireflies/settings.ts).
  fireflies    Json?
  // Claude translation cap (see src/translation/cost.ts).
  costs        Json?
  // Retention + PII masking (see src/privacy/settings.ts).
  privacy      Json?
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum FirefliesReservationStatus {
  RESERVED // minutes held while the job runs
  COMMITTED // sent to Fireflies; counts as used (actual minutes when known)
  RELEASED // never uploaded; minutes returned
}

// Fireflies upload minutes, one row per call per month. Monthly usage is
// aggregated from these rows (calendar month in UTC, like Fireflies' reset).
model FirefliesReservation {
  id            String                     @id @default(uuid(7)) @db.Uuid
  callId        String                     @map("call_id") @db.Uuid
  month         String // "YYYY-MM" (UTC)
  minutes       Int
  actualMinutes Int?                       @map("actual_minutes")
  live          Boolean
  status        FirefliesReservationStatus @default(RESERVED)
  uploadedAt    DateTime?                  @map("uploaded_at")
  transcriptId  String?                    @map("transcript_id")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([month, status])
  @@index([callId, status])
  @@map("fireflies_reservations")
}

// Last time each worker polled or heartbeated (worker IDs change on restart).
model WorkerSeen {
  workerId   String   @id @map("worker_id")
  lastSeenAt DateTime @map("last_seen_at")

  @@map("worker_seen")
}

// Zoho Cliq alert dedupe: an active alert repeats at most every 6 h; "resolved" is sent once.
model AlertState {
  key        String    @id
  active     Boolean   @default(false)
  message    String?
  firstAt    DateTime? @map("first_at")
  lastSentAt DateTime? @map("last_sent_at")
  resolvedAt DateTime? @map("resolved_at")

  @@map("alert_states")
}

// Business-only mode: numbers that always upload even when saved as a personal contact on the phone.
// key = last 10 digits (or all digits when shorter), the same as the app's PrivacyFilter.key().
model ClientNumber {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  raw       String
  label     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("client_numbers")
}

// Activity tracker (docs/dialer-plan.md). A contact is created the first time a number gets an activity;
// its owner is the rep who logged that first activity. Calls belong to a contact by phone_e164 (no FK).
enum ContactStatus {
  NEW
  INTERESTED
  CALL_BACK
  NOT_INTERESTED
  NO_ANSWER
}

enum ActivityType {
  CALL
  WHATSAPP
  NOTE
}

enum CallOutcome {
  INTERESTED
  CALL_BACK
  NOT_INTERESTED
  NO_ANSWER
}

model Contact {
  id             String        @id @default(uuid(7)) @db.Uuid
  phoneE164      String        @unique @map("phone_e164")
  name           String?
  company        String?
  ownerId        String?       @map("owner_id") @db.Uuid
  status         ContactStatus @default(NEW)
  nextFollowUpAt DateTime?     @map("next_follow_up_at")
  lastActivityAt DateTime?     @map("last_activity_at")
  city           String?
  // Lead source name, "csv" or "manual" (stage 2/3).
  source         String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  owner      User?      @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]
  followUpTasks FollowUpTask[]
  listItems  CallListItem[]
  leadEvents LeadEvent[]

  @@index([ownerId])
  @@index([status])
  @@index([nextFollowUpAt])
  @@index([lastActivityAt(sort: Desc)])
  @@map("contacts")
}

model Activity {
  id         String       @id @default(uuid(7)) @db.Uuid
  // UUID made on the phone so retried POSTs are idempotent; dashboard rows use a server UUID.
  clientId   String       @unique @map("client_id")
  contactId  String       @map("contact_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       ActivityType
  outcome    CallOutcome?
  note       String?
  followUpAt DateTime?    @map("follow_up_at")
  durationS  Int?         @map("duration_s")
  occurredAt DateTime     @map("occurred_at")
  // The rep's recorded Call with the same number within 10 minutes, linked from either side.
  callId     String?      @map("call_id") @db.Uuid
  via        DialVia?     @map("via")
  // Stage 2: custom outcome (outcome keeps its base enum), call list item, WhatsApp/SMS channel, template.
  outcomeId      String?  @map("outcome_id") @db.Uuid
  callListItemId String?  @map("call_list_item_id") @db.Uuid
  channel        String?
  templateId     String?  @map("template_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  call         Call?            @relation(fields: [callId], references: [id], onDelete: SetNull)
  outcomeDef   OutcomeDef?      @relation(fields: [outcomeId], references: [id], onDelete: SetNull)
  callListItem CallListItem?    @relation(fields: [callListItemId], references: [id], onDelete: SetNull)
  template     MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([contactId, occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([callId])
  @@index([outcomeId])
  @@index([callListItemId])
  @@map("activities")
}

// Stage 1: how a call was dialled, missed-call follow-up tasks, desktop click-to-call intents.
enum DialVia {
  LAPTOP
  APP
  PHONE_DIALER
}

enum FollowUpKind {
  MISSED_CALL
  NEW_LEAD
}

enum FollowUpState {
  OPEN
  DONE
  DISMISSED
}

// Desktop click-to-call: one row per tel: click; matched to the rep's next outgoing Call on that number.
model DialIntent {
  id        String   @id @default(uuid(7)) @db.Uuid
  clientId  String   @unique @map("client_id") // the dashboard PendingCall.clientId (UUID)
  userId    String   @map("user_id") @db.Uuid
  phoneE164 String   @map("phone_e164")
  createdAt DateTime @default(now()) @map("created_at")
  callId    String?  @unique @map("call_id") @db.Uuid // set when matched
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phoneE164, createdAt])
  @@map("dial_intents")
}

// Missed call -> task (stage 1 only MISSED_CALL). Contact follow-ups stay on Contact.nextFollowUpAt.
model FollowUpTask {
  id         String        @id @default(uuid(7)) @db.Uuid
  clientId   String        @unique @map("client_id") // "missed:<callLogDateMs>:<last10>" from the phone
  userId     String        @map("user_id") @db.Uuid
  contactId  String?       @map("contact_id") @db.Uuid // set when a Contact exists for phoneE164
  phoneE164  String        @map("phone_e164")
  callerName String?       @map("caller_name") // call-log cached name
  kind       FollowUpKind  @default(MISSED_CALL)
  state      FollowUpState @default(OPEN)
  occurredAt DateTime      @map("occurred_at") // missed call time
  dueAt      DateTime      @map("due_at") // = occurredAt; snooze moves it
  doneAt     DateTime?     @map("done_at")
  leadEventId String?      @unique @map("lead_event_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadEvent  LeadEvent?    @relation(fields: [leadEventId], references: [id], onDelete: SetNull)

  @@index([userId, state, dueAt])
  @@index([phoneE164])
  @@map("follow_up_tasks")
}

// ---- Stage 2: custom outcomes, scripts, templates, call lists ------------------------------------------

enum OutcomeRule {
  NONE
  ASK_FOLLOW_UP
  ASK_MEETING
  ASK_CALLBACK
  CLOSE_LEAD
  RETRY
  REMOVE_FROM_LISTS
}

enum CallListState {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CallListItemState {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
  REMOVED
}

// Admin-defined call outcomes. Activity.outcome keeps the base enum so reports and Zoho keep working.
model OutcomeDef {
  id          String      @id @default(uuid(7)) @db.Uuid
  key         String?     @unique
  label       String
  color       String
  sortOrder   Int         @default(0) @map("sort_order")
  active      Boolean     @default(true)
  baseOutcome CallOutcome @map("base_outcome")
  rule        OutcomeRule @default(NONE)
  retryHours  Int?        @map("retry_hours")
  addToDnc    Boolean     @default(false) @map("add_to_dnc")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  activities Activity[]
  listItems  CallListItem[]

  @@map("outcome_defs")
}

model CallScript {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  sections  Json // [{ heading, text }]
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lists CallList[]

  @@map("call_scripts")
}

model MessageTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  body      String
  whatsapp  Boolean  @default(true)
  sms       Boolean  @default(true)
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activities Activity[]

  @@map("message_templates")
}

model CallList {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String
  scriptId    String?       @map("script_id") @db.Uuid
  state       CallListState @default(ACTIVE)
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  script    CallScript?        @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  createdBy User?              @relation("CallListCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignees CallListAssignee[]
  items     CallListItem[]

  @@index([state])
  @@map("call_lists")
}

model CallListAssignee {
  listId String @map("list_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  list CallList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@index([userId])
  @@map("call_list_assignees")
}

model CallListItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  listId         String            @map("list_id") @db.Uuid
  contactId      String            @map("contact_id") @db.Uuid
  position       Int
  state          CallListItemState @default(PENDING)
  claimedById    String?           @map("claimed_by_id") @db.Uuid
  leaseUntil     DateTime?         @map("lease_until")
  retryAt        DateTime?         @map("retry_at")
  attempts       Int               @default(0)
  lastOutcomeId  String?           @map("last_outcome_id") @db.Uuid
  lastOutcome    CallOutcome?      @map("last_outcome")
  lastActivityAt DateTime?         @map("last_activity_at")
  doneById       String?           @map("done_by_id") @db.Uuid
  doneAt         DateTime?         @map("done_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  list           CallList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  claimedBy      User?       @relation("ListItemClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  doneBy         User?       @relation("ListItemDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  lastOutcomeDef OutcomeDef? @relation(fields: [lastOutcomeId], references: [id], onDelete: SetNull)
  activities     Activity[]

  @@unique([listId, contactId])
  @@index([listId, state, position])
  @@index([contactId, state])
  @@map("call_list_items")
}

// ---- Stage 3: do-not-call, lead sources, AI call scores ----------------------------------------------

enum DncSource {
  MANUAL
  OUTCOME
  IMPORT
}

// key = numberKey() (last 10 digits), the same rule as client_numbers and the app's PrivacyFilter.key().
model DncNumber {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String    @unique
  phoneE164   String?   @map("phone_e164")
  raw         String
  reason      String?
  source      DncSource @default(MANUAL)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("dnc_numbers")
}

model LeadSource {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  tokenHash String   @unique @map("token_hash")
  tokenHint String   @map("token_hint")
  active    Boolean  @default(true)
  repPool   String[] @default([]) @map("rep_pool")
  fieldMap  Json?    @map("field_map")
  rrCursor  String?  @map("rr_cursor") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events LeadEvent[]

  @@map("lead_sources")
}

model LeadEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  sourceId     String?  @map("source_id") @db.Uuid
  externalId   String?  @map("external_id")
  contactId    String?  @map("contact_id") @db.Uuid
  assignedToId String?  @map("assigned_to_id") @db.Uuid
  status       String // ASSIGNED | EXISTING_OWNER | DNC | NO_REP | INVALID
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  source     LeadSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  task       FollowUpTask?

  @@unique([sourceId, externalId])
  @@index([createdAt(sort: Desc)])
  @@map("lead_events")
}

model CallScore {
  callId          String   @id @map("call_id") @db.Uuid
  overall         Int
  scriptAdherence Int?     @map("script_adherence")
  sentiment       String
  objections      Json
  nextStep        String?  @map("next_step")
  strengths       Json
  improvements    Json
  scriptId        String?  @map("script_id") @db.Uuid
  model           String
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  costUsd         Float?   @map("cost_usd")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_scores")
}

/// A dashboard sign-in: the Windows app or a browser. Listed with the phones on the Health page; revoking one
/// signs that computer out on its next request.
model WebSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// "desktop" (UIC Dialer for Windows) or "browser".
  kind        String
  /// Windows app version, or a short browser name ("Chrome 142 on Windows").
  label       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
  @@map("web_sessions")
}

