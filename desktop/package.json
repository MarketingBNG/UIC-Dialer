{
  "name": "uic-dialer-desktop",
  "productName": "UIC Dialer",
  "version": "1.1.0",
  "private": true,
  "description": "UIC Dialer for Windows: the dashboard plus click-to-call through Phone Link.",
  "author": "USA India CFO",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/rules.js && node --check src/updater.js",
    "test": "node --test test/rules.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.usaindiacfo.uicdialer",
    "productName": "UIC Dialer",
    "artifactName": "UIC-Dialer-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "UIC Dialer sign-in",
        "schemes": [
          "uicdialer"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "UIC Dialer",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "MarketingBNG",
        "repo": "UIC-Dialer",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © USA India CFO"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
